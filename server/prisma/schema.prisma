generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Driver {
  id                 Int      @id @default(autoincrement())

  name               String
  email              String?

  gender             String?
  phone_number       String
  alt_phone_number   String?

  nationality        String?
  birthdate          String?

  address            String?

  age                Int?

  has_license        String?
  license_file_path  String?

  is_employed        String?
  ride_experience    String?

  ride_platform      String?

  location           String?

  accessibility      String?
  growth_goals       String?

  referral_source    String?

  terms_agreed       Boolean? @default(false)

  photo_url          String?

  created_at         DateTime @default(now())


  @@map("driver")
}

model User {
  id                          Int      @id @default(autoincrement())
  fayda_id                    String   @unique
  name                        String?
  phone                       String?
  alternative_phone            String?
  email                       String?
  photo_url                   String?
  age                         Int?
  gender                      String?
  has_license                 String?
  license_photo               String?
  currently_employed          String?
  previous_experience         String?
  previous_platform           String?
  location                    String?
  accessibility_considerations String?
  goals                       String?
  future_opportunities        String?
  heard_from                  String?
  till_number                 String?
  fcn_number                  String?
  targa_number                String?
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  @@map("user")
}