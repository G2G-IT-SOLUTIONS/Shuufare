generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Driver {
  id                   Int      @id @default(autoincrement())
  fayda_id             String   @unique
  name                 String?
  phone_number         String?  // phone to phone_number
  alt_phone_number     String?  // alternative_phone to alt_phone_number
  email                String?
  photo_url            String?
  age                  Int?
  gender               String?
  nationality          String?
  location             String?  // current_address to location
  birthdate            String?
  has_license          String?
  license_file_path    String?  // license_photo to license_file_path
  is_employed          String?  // currently_employed to is_employed
  ride_experience      String?  // previous_experience to ride_experience
  ride_platform        String?  // ride_platform to ride_platform
  address              String?  // location to address
  accessibility        String?  // accessibility to accessibility
  growth_goals         String?  // goals to growth_goals
  future_opportunities String?
  referral_source      String?  // referral_source to referral_source
  till_number          String?
  terms_agreed         Boolean? @default(false)
  fcn_number           String?
  targa_number         String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@map("user")
}

model Admin {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String   // Hashed password
  fullName    String
  phone       String?
  role        String   @default("admin")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@map("admins")
}