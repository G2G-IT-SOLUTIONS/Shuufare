generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}


model Driver {
  id                 Int      @id @default(autoincrement())

  name               String
  email              String?

  gender             String?
  phone_number       String
  alt_phone_number   String?

  nationality        String?
  birthdate          String?

  address            String?

  age                Int?

  has_license        String?
  license_file_path  String?

  is_employed        String?
  ride_experience    String?

  ride_platform      String?

  location           String?

  accessibility      String?
  growth_goals       String?

  referral_source    String?

  terms_agreed       Boolean? @default(false)

  photo_url          String?

  created_at         DateTime @default(now())


  // Relations
  applications       Application[]
  documents          Document[]
  training           Training?
  vehicle            Vehicle?


  @@map("driver")
}



model Application {

  id          Int      @id @default(autoincrement())

  driver_id   Int

  status      String   @default("SUBMITTED")

  notes       String?

  created_at  DateTime @default(now())


  driver Driver @relation(fields: [driver_id], references: [id])


  @@map("application")
}



model Document {

  id          Int      @id @default(autoincrement())

  driver_id   Int

  type        String

  file_path   String

  created_at  DateTime @default(now())


  driver Driver @relation(fields: [driver_id], references: [id])


  @@map("document")
}



model Training {

  id          Int      @id @default(autoincrement())

  driver_id   Int      @unique

  status      String   @default("NOT_STARTED")

  training_date DateTime?

  notes       String?


  driver Driver @relation(fields: [driver_id], references: [id])


  @@map("training")
}



model Vehicle {

  id              Int      @id @default(autoincrement())


  driver_id       Int?     @unique


  plate_number    String

  model           String?

  vehicle_type    String?

  status          String   @default("AVAILABLE")


  created_at      DateTime @default(now())


  driver Driver? @relation(fields: [driver_id], references: [id])


  @@map("vehicle")
}




model Admin {

  id          Int      @id @default(autoincrement())


  email       String   @unique

  password    String


  created_at  DateTime @default(now())


  @@map("admin")
}